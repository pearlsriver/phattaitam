# Đổi tên file này thành .env.local rồi điền giá trị thật.

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# ---- Địa chỉ chính thức của website ----
NEXT_PUBLIC_SITE_URL=https://www.phattaitam.com

# ---- Cloudflare R2 (lưu nhạc, sách, ảnh) ----
# Tên miền công khai của bucket R2. Để TRỐNG = vẫn dùng Supabase Storage như cũ.
NEXT_PUBLIC_MEDIA_URL=https://media.phattaitam.com
# 4 giá trị dưới đây là BÍ MẬT: chỉ đặt trên máy bạn và trong Vercel, KHÔNG thêm tiền tố NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phattaitam-media
